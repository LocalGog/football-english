{
 "topics": [
  {
   "id": "present-simple",
   "title": "Present Simple: I play",
   "rule": "Про те, що буває завжди або регулярно. Дієслово без змін: I play, we train, they watch.",
   "examples": [
    {
     "english": "I *play* football every day.",
     "ukrainian": "Я граю у футбол щодня."
    },
    {
     "english": "We always *train* on Monday.",
     "ukrainian": "Ми завжди тренуємося в понеділок."
    }
   ]
  },
  {
   "id": "present-simple-3rd",
   "title": "Present Simple: he plays",
   "rule": "Після he, she, it до дієслова додаємо -s: he plays. Після -ch, -sh, -o додаємо -es: she watches, he goes. Study → studies.",
   "examples": [
    {
     "english": "He *plays* for a big club.",
     "ukrainian": "Він грає за великий клуб."
    },
    {
     "english": "She *watches* every match.",
     "ukrainian": "Вона дивиться кожен матч."
    }
   ]
  },
  {
   "id": "present-simple-questions",
   "title": "Do і does",
   "rule": "Питання: Do you…? Does he…? Заперечення: don't, doesn't. Після does і doesn't дієслово без -s.",
   "examples": [
    {
     "english": "*Do* you play football?",
     "ukrainian": "Ти граєш у футбол?"
    },
    {
     "english": "He *doesn't like* rain.",
     "ukrainian": "Він не любить дощ."
    }
   ]
  },
  {
   "id": "present-continuous",
   "title": "Present Continuous: зараз",
   "rule": "Те, що відбувається саме зараз: am / is / are + дієслово з -ing.",
   "examples": [
    {
     "english": "He *is running* with the ball.",
     "ukrainian": "Він біжить з м'ячем."
    },
    {
     "english": "The fans *are singing*.",
     "ukrainian": "Вболівальники співають."
    }
   ]
  },
  {
   "id": "present-continuous-questions",
   "title": "Present Continuous: питання",
   "rule": "Питання: Is he…? Are they…? Заперечення: I'm not, isn't, aren't.",
   "examples": [
    {
     "english": "What *is* he *doing*?",
     "ukrainian": "Що він робить?"
    },
    {
     "english": "They *aren't playing* well.",
     "ukrainian": "Вони грають не дуже добре."
    }
   ]
  },
  {
   "id": "simple-vs-continuous",
   "title": "Завжди чи зараз?",
   "rule": "Регулярно (every day, usually, always) — Present Simple. Саме зараз (now, look!, listen!) — Present Continuous.",
   "examples": [
    {
     "english": "He usually *plays* on the left.",
     "ukrainian": "Зазвичай він грає зліва."
    },
    {
     "english": "Today he *is playing* on the right.",
     "ukrainian": "Сьогодні він грає справа."
    }
   ]
  },
  {
   "id": "past-be",
   "title": "Was і were",
   "rule": "Минуле від am, is, are: I, he, she, it — was; we, you, they — were. Заперечення: wasn't, weren't.",
   "examples": [
    {
     "english": "The match *was* great.",
     "ukrainian": "Матч був чудовий."
    },
    {
     "english": "We *were* at the stadium.",
     "ukrainian": "Ми були на стадіоні."
    }
   ]
  },
  {
   "id": "past-regular",
   "title": "Past Simple: -ed",
   "rule": "Про минуле додаємо до дієслова -ed: play → played. Stop → stopped, try → tried.",
   "examples": [
    {
     "english": "We *played* well last Saturday.",
     "ukrainian": "Минулої суботи ми добре зіграли."
    },
    {
     "english": "He *passed* the ball to me.",
     "ukrainian": "Він віддав мені пас."
    }
   ]
  },
  {
   "id": "past-irregular",
   "title": "Неправильні дієслова",
   "rule": "Деякі дієслова в минулому мають власну форму. Її треба запам'ятати: go → went, win → won, see → saw.",
   "examples": [
    {
     "english": "We *won* the match.",
     "ukrainian": "Ми виграли матч."
    },
    {
     "english": "He *came* to training late.",
     "ukrainian": "Він прийшов на тренування пізно."
    }
   ]
  },
  {
   "id": "past-questions",
   "title": "Did і didn't",
   "rule": "Питання й заперечення в минулому: Did you…? We didn't… Після did і didn't дієслово в першій формі: Did he score?",
   "examples": [
    {
     "english": "*Did* you *win*?",
     "ukrainian": "Ви виграли?"
    },
    {
     "english": "We *didn't lose*.",
     "ukrainian": "Ми не програли."
    }
   ]
  },
  {
   "id": "past-mixed",
   "title": "Past Simple: усе разом",
   "rule": "Розповідаємо про минулий матч: was / were, -ed і неправильні дієслова.",
   "examples": [
    {
     "english": "It *was* a hard match.",
     "ukrainian": "Це був важкий матч."
    },
    {
     "english": "The goalkeeper *made* a great save.",
     "ukrainian": "Воротар зробив чудовий сейв."
    }
   ]
  },
  {
   "id": "future-will",
   "title": "Future: will",
   "rule": "Прогноз, обіцянка, рішення: will + дієслово без змін. Заперечення: won't.",
   "examples": [
    {
     "english": "We *will win* the next match.",
     "ukrainian": "Ми виграємо наступний матч."
    },
    {
     "english": "He *won't play* tomorrow.",
     "ukrainian": "Він не гратиме завтра."
    }
   ]
  },
  {
   "id": "going-to",
   "title": "Going to",
   "rule": "План або те, що от-от станеться: am / is / are going to + дієслово.",
   "examples": [
    {
     "english": "We *are going to attack*.",
     "ukrainian": "Ми збираємося атакувати."
    },
    {
     "english": "Look! It *is going to rain*.",
     "ukrainian": "Глянь! Зараз піде дощ."
    }
   ]
  },
  {
   "id": "future-mixed",
   "title": "Will чи going to?",
   "rule": "Going to — план або те, що очевидно станеться. Will — думка, прогноз, обіцянка.",
   "examples": [
    {
     "english": "I *am going to buy* new boots.",
     "ukrainian": "Я збираюся купити нові бутси."
    },
    {
     "english": "I think it *will be* a draw.",
     "ukrainian": "Думаю, буде нічия."
    }
   ]
  },
  {
   "id": "present-perfect",
   "title": "Present Perfect",
   "rule": "Результат на цей момент: have / has + третя форма дієслова: I have scored, she has won.",
   "examples": [
    {
     "english": "I *have scored* ten goals.",
     "ukrainian": "Я забив десять голів."
    },
    {
     "english": "She *has won* the cup.",
     "ukrainian": "Вона виграла кубок."
    }
   ]
  },
  {
   "id": "pp-already-yet",
   "title": "Already, just, yet",
   "rule": "Already — уже, just — щойно: у ствердженнях. Yet — уже (у питаннях), ще (у запереченнях), стоїть у кінці.",
   "examples": [
    {
     "english": "The match *has just started*.",
     "ukrainian": "Матч щойно почався."
    },
    {
     "english": "We *haven't lost yet*.",
     "ukrainian": "Ми ще не програли."
    }
   ]
  },
  {
   "id": "pp-ever-never",
   "title": "Ever і never",
   "rule": "Ever — коли-небудь (у питаннях), never — ніколи. Have you ever…? I have never…",
   "examples": [
    {
     "english": "*Have* you *ever played* in a final?",
     "ukrainian": "Ти коли-небудь грав у фіналі?"
    },
    {
     "english": "I *have never been* to Spain.",
     "ukrainian": "Я ніколи не був в Іспанії."
    }
   ]
  },
  {
   "id": "tenses-mixed",
   "title": "Усі часи разом",
   "rule": "Present Simple, Present Continuous, Past Simple, Future і Present Perfect в одному матчі.",
   "examples": [
    {
     "english": "Right now we *are playing* the final!",
     "ukrainian": "Просто зараз ми граємо у фіналі!"
    },
    {
     "english": "We *have won* the World Cup!",
     "ukrainian": "Ми виграли чемпіонат світу!"
    }
   ]
  }
 ],
