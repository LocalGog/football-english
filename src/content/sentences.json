[
  {"id":"s01","english":"I am a player.","ukrainian":"Я гравець."},
  {"id":"s02","english":"This is my ball.","ukrainian":"Це мій м'яч."},
  {"id":"s03","english":"Pass the ball!","ukrainian":"Пасуй м'яч!"},
  {"id":"s04","english":"I like football.","ukrainian":"Я люблю футбол."},
  {"id":"s05","english":"I am a goalkeeper.","ukrainian":"Я воротар."},
  {"id":"s06","english":"He is a striker.","ukrainian":"Він нападник."},
  {"id":"s07","english":"This is my shirt.","ukrainian":"Це моя футболка."},
  {"id":"s08","english":"I have boots.","ukrainian":"У мене є бутси."},
  {"id":"s09","english":"The ball is white.","ukrainian":"М'яч білий."},
  {"id":"s10","english":"My shirt is red.","ukrainian":"Моя футболка червона."},
  {"id":"s11","english":"I have one ball.","ukrainian":"У мене один м'яч."},
  {"id":"s12","english":"We have two teams.","ukrainian":"У нас дві команди."},
  {"id":"s13","english":"I am number ten.","ukrainian":"Я номер десять."},
  {"id":"s14","english":"We have seven players.","ukrainian":"У нас сім гравців."},
  {"id":"s15","english":"This is my foot.","ukrainian":"Це моя стопа."},
  {"id":"s16","english":"Use your head!","ukrainian":"Грай головою!"},
  {"id":"s17","english":"Hello, coach!","ukrainian":"Привіт, тренере!"},
  {"id":"s18","english":"He is my friend.","ukrainian":"Він мій друг."},
  {"id":"s19","english":"The stadium is big.","ukrainian":"Стадіон великий."},
  {"id":"s20","english":"We win the cup!","ukrainian":"Ми виграємо кубок!"},
  {"id":"s21","english":"We are a team.","ukrainian":"Ми команда."},
  {"id":"s22","english":"I play football.","ukrainian":"Я граю у футбол."},
  {"id":"s23","english":"I am number eleven.","ukrainian":"Я номер одинадцять."},
  {"id":"s24","english":"We have twelve players.","ukrainian":"У нас дванадцять гравців."},
  {"id":"s25","english":"He is number twenty.","ukrainian":"Він номер двадцять."},
  {"id":"s26","english":"We have eighteen balls.","ukrainian":"У нас вісімнадцять м'ячів."},
  {"id":"s27","english":"He is fast.","ukrainian":"Він швидкий."},
  {"id":"s28","english":"The goalkeeper is tall.","ukrainian":"Воротар високий."},
  {"id":"s29","english":"The ball is in the net.","ukrainian":"М'яч у сітці."},
  {"id":"s30","english":"He is on the bench.","ukrainian":"Він на лаві запасних."},
  {"id":"s31","english":"Look at the ball!","ukrainian":"Дивись на м'яч!"},
  {"id":"s32","english":"Listen to the coach!","ukrainian":"Слухай тренера!"},
  {"id":"s33","english":"We play in a team.","ukrainian":"Ми граємо в команді."},
  {"id":"s34","english":"Catch the ball!","ukrainian":"Лови м'яч!"},
  {"id":"s35","english":"She is a defender.","ukrainian":"Вона захисниця."},
  {"id":"s36","english":"They are my friends.","ukrainian":"Вони мої друзі."},
  {"id":"s37","english":"What is your name?","ukrainian":"Як тебе звати?"},
  {"id":"s38","english":"What position do you play?","ukrainian":"На якій позиції ти граєш?"},
  {"id":"s39","english":"I have a ball.","ukrainian":"У мене є м'яч."},
  {"id":"s40","english":"I want to play.","ukrainian":"Я хочу грати."},
  {"id":"s41","english":"This is my family.","ukrainian":"Це моя сім'я."},
  {"id":"s42","english":"My brother is a goalkeeper.","ukrainian":"Мій брат воротар."},
  {"id":"s43","english":"Pass to the left!","ukrainian":"Пасуй ліворуч!"},
  {"id":"s44","english":"Run forward!","ukrainian":"Біжи вперед!"},
  {"id":"s45","english":"What is the score?","ukrainian":"Який рахунок?"},
  {"id":"s46","english":"It is the first half.","ukrainian":"Це перший тайм."},
  {"id":"s47","english":"I like training.","ukrainian":"Я люблю тренування."},
  {"id":"s48","english":"We need a rest.","ukrainian":"Нам потрібен відпочинок."},
  {"id":"s49","english":"It is raining.","ukrainian":"Іде дощ."},
  {"id":"s50","english":"The water is cold.","ukrainian":"Вода холодна."},
  {"id":"s51","english":"I am happy.","ukrainian":"Я щасливий."},
  {"id":"s52","english":"The coach is angry.","ukrainian":"Тренер злий."},
  {"id":"s53","english":"The match is on Sunday.","ukrainian":"Матч у неділю."},
  {"id":"s54","english":"We train on Monday.","ukrainian":"Ми тренуємося в понеділок."},
  {"id":"s55","english":"The match is tomorrow.","ukrainian":"Матч завтра."},
  {"id":"s56","english":"We play in the evening.","ukrainian":"Ми граємо ввечері."},
  {"id":"s57","english":"It is a penalty!","ukrainian":"Це пенальті!"},
  {"id":"s58","english":"We attack on the left.","ukrainian":"Ми атакуємо зліва."},
  {"id":"s59","english":"What a save!","ukrainian":"Який сейв!"},
  {"id":"s60","english":"The match is a draw.","ukrainian":"У матчі нічия."},
  {"id":"s61","english":"He is drinking water.","ukrainian":"Він п'є воду."},
  {"id":"s62","english":"We are watching the match.","ukrainian":"Ми дивимося матч."},
  {"id":"s63","english":"I have milk for breakfast.","ukrainian":"На сніданок у мене молоко."},
  {"id":"s64","english":"I like apple juice.","ukrainian":"Я люблю яблучний сік."},
  {"id":"s65","english":"I go to school by bus.","ukrainian":"Я їду до школи автобусом."},
  {"id":"s66","english":"We play in the park.","ukrainian":"Ми граємо в парку."},
  {"id":"s67","english":"We are the champions!","ukrainian":"Ми чемпіони!"},
  {"id":"s68","english":"I have a ticket.","ukrainian":"У мене є квиток."},
  {"id":"s69","english":"We are ready.","ukrainian":"Ми готові."},
  {"id":"s70","english":"You are the best!","ukrainian":"Ти найкращий!"},
  {"id":"s71","english":"I train every day.","ukrainian":"Я тренуюся щодня."},
  {"id":"s72","english":"We always play on Saturday.","ukrainian":"Ми завжди граємо в суботу."},
  {"id":"s73","english":"He plays for a big club.","ukrainian":"Він грає за великий клуб."},
  {"id":"s74","english":"She speaks English.","ukrainian":"Вона говорить англійською."},
  {"id":"s75","english":"Do you play football?","ukrainian":"Ти граєш у футбол?"},
  {"id":"s76","english":"He doesn't like rain.","ukrainian":"Він не любить дощ."},
  {"id":"s77","english":"He is running with the ball.","ukrainian":"Він біжить з м'ячем."},
  {"id":"s78","english":"The fans are singing.","ukrainian":"Вболівальники співають."},
  {"id":"s79","english":"What is he doing?","ukrainian":"Що він робить?"},
  {"id":"s80","english":"They are not playing well.","ukrainian":"Вони грають не дуже добре."},
  {"id":"s81","english":"He usually plays on the left.","ukrainian":"Зазвичай він грає зліва."},
  {"id":"s82","english":"Today he is playing on the right.","ukrainian":"Сьогодні він грає справа."},
  {"id":"s83","english":"The match was great.","ukrainian":"Матч був чудовий."},
  {"id":"s84","english":"We were at the stadium yesterday.","ukrainian":"Учора ми були на стадіоні."},
  {"id":"s85","english":"We played well last Saturday.","ukrainian":"Минулої суботи ми добре зіграли."},
  {"id":"s86","english":"He passed the ball to me.","ukrainian":"Він віддав мені пас."},
  {"id":"s87","english":"We won the match.","ukrainian":"Ми виграли матч."},
  {"id":"s88","english":"He came to training late.","ukrainian":"Він прийшов на тренування пізно."},
  {"id":"s89","english":"I bought new boots.","ukrainian":"Я купив нові бутси."},
  {"id":"s90","english":"He fell and hit his head.","ukrainian":"Він упав і вдарився головою."},
  {"id":"s91","english":"The coach told us a story.","ukrainian":"Тренер розповів нам історію."},
  {"id":"s92","english":"The match began at six.","ukrainian":"Матч почався о шостій."},
  {"id":"s93","english":"I wore my lucky shirt.","ukrainian":"Я вдягнув свою щасливу футболку."},
  {"id":"s94","english":"He broke his leg last year.","ukrainian":"Минулого року він зламав ногу."},
  {"id":"s95","english":"Did you win the match?","ukrainian":"Ви виграли матч?"},
  {"id":"s96","english":"We didn't lose.","ukrainian":"Ми не програли."},
  {"id":"s97","english":"We scored in the first half.","ukrainian":"Ми забили в першому таймі."},
  {"id":"s98","english":"The goalkeeper made a great save.","ukrainian":"Воротар зробив чудовий сейв."},
  {"id":"s99","english":"We will win the next match.","ukrainian":"Ми виграємо наступний матч."},
  {"id":"s100","english":"It will rain tonight.","ukrainian":"Сьогодні ввечері піде дощ."},
  {"id":"s101","english":"I think we will win.","ukrainian":"Я думаю, ми виграємо."},
  {"id":"s102","english":"Maybe it will snow.","ukrainian":"Можливо, піде сніг."},
  {"id":"s103","english":"We are going to attack.","ukrainian":"Ми збираємося атакувати."},
  {"id":"s104","english":"He is going to take the penalty.","ukrainian":"Він збирається бити пенальті."},
  {"id":"s105","english":"I'm going to buy new boots.","ukrainian":"Я збираюся купити нові бутси."},
  {"id":"s106","english":"I think it will be a draw.","ukrainian":"Думаю, буде нічия."},
  {"id":"s107","english":"I have scored ten goals.","ukrainian":"Я забив десять голів."},
  {"id":"s108","english":"She has won the cup.","ukrainian":"Вона виграла кубок."},
  {"id":"s109","english":"The match has just started.","ukrainian":"Матч щойно почався."},
  {"id":"s110","english":"We haven't lost yet.","ukrainian":"Ми ще не програли."},
  {"id":"s111","english":"Have you ever been to Spain?","ukrainian":"Ти коли-небудь був в Іспанії?"},
  {"id":"s112","english":"I have never seen snow in May.","ukrainian":"Я ніколи не бачив снігу в травні."},
  {"id":"s113","english":"We have won the World Cup!","ukrainian":"Ми виграли чемпіонат світу!"},
  {"id":"s114","english":"Tomorrow we will celebrate.","ukrainian":"Завтра ми святкуватимемо."}
]
